---
// 首页（REDESIGN_PLAN §10.1）：Hero + 主截图 + 六特性卡 + 双截图 + 版本徽章 + 下载 CTA。
import Base from '../layouts/Base.astro'
import { fetchLatestRelease, versionOf, FALLBACK_VERSION } from '../lib/releases'

const release = await fetchLatestRelease()
const version = versionOf(release?.tag_name) || FALLBACK_VERSION
const releaseUrl = release?.html_url ?? 'https://github.com/pan-nie/Nmail/releases'

// SoftwareApplication 结构化数据：争取搜索结果富摘要（应用名/平台/免费/开源）
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nmail',
  url: 'https://nmail.whizzzest.com/',
  image: 'https://nmail.whizzzest.com/icon-512.png',
  description: 'Nmail —— AI 驱动的本地聚合邮箱客户端：AI 分类整理、草稿待审、每日摘要、多账号聚合，数据全程留在本机。',
  applicationCategory: 'CommunicationApplication',
  operatingSystem: 'Windows, macOS, Linux',
  softwareVersion: version,
  author: { '@type': 'Organization', name: 'Nmail', url: 'https://nmail.whizzzest.com/' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
}

const features = [
  {
    icon: '🤖', title: 'AI 总管家：会干活的对话 Agent',
    desc: '查、搜、整理、归档、起草、发送，一句话全包——拿不准先问你，写操作先审批后自动续跑；跨会话记住你的偏好，越用越懂你。',
  },
  {
    icon: '✍️', title: 'AI 起草 · 你把关',
    desc: '待回复的邮件 AI 先拟好草稿，你改一改再发；批准/拒绝后 AI 自动收尾总结，审批/自动双模式由你掌控。',
  },
  {
    icon: '📊', title: '每日摘要 + AI 摘要',
    desc: '每天固定时间一份邮箱综述：多少封、哪些重要、谁在等你回复；开启 AI 摘要，总管家到点巡箱总结并拟好回复草稿（只进待审，绝不自动发送）。',
  },
  {
    icon: '📥', title: '多账号聚合',
    desc: 'Gmail / Outlook / QQ / 163……全部账号一个收件箱，智能视图跨账号浏览，文件夹像资源管理器一样管理。',
  },
  {
    icon: '🔒', title: '本地优先隐私',
    desc: '服务只跑在本机（127.0.0.1），邮件、通讯录、密钥全部留在你的设备，没有云端中转，没有账号体系。',
  },
  {
    icon: '💻', title: '跨平台使用',
    desc: 'Windows / macOS / Linux，一个浏览器即可访问；一行 uvx 命令全平台启动，也有免安装单文件可选。',
  },
]
---

<Base title="AI 驱动的本地邮箱管家">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="hero">
    <span class="pill"><span class="dot"></span> 最新版本 v{version} · <a href={releaseUrl} target="_blank" rel="noopener">查看发布</a></span>
    <h1>把邮箱交给 AI 总管家<br /><span class="grad">数据一步也不离开你的电脑</span></h1>
    <p class="sub">
      Nmail 是一个本地运行的 AI 聚合邮箱客户端：多账号收在一个收件箱，
      AI 替你分类、归档、拟稿，而发不发、动不动，永远由你决定。
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="/download/">免费下载</a>
      <a class="btn btn-ghost" href="https://github.com/pan-nie/Nmail" target="_blank" rel="noopener">GitHub 源码 ↗</a>
    </div>
  </section>

  <section class="shot-hero">
    <img src="/shots/nmail-demo-inbox.png" alt="Nmail 主界面：多账号聚合收件箱，AI 分类标签、文件夹树、三栏布局" width="1060" loading="eager" />
    <p class="caption">多账号聚合收件箱 · AI 分类标签 · 文件夹树与快捷键齐备</p>
  </section>

  <section class="grid">
    {features.map((f) => (
      <article class="card">
        <div class="icon">{f.icon}</div>
        {/* h2 而非 h3：卡片紧跟 h1，标题跳级会被 Lighthouse/无障碍扣分 */}
        <h2>{f.title}</h2>
        <p>{f.desc}</p>
      </article>
    ))}
  </section>

  <section class="duo">
    <figure>
      <img src="/shots/nmail-demo-assistant.png" alt="AI 总管家对话页：一句话任务，多步执行，写操作先审批" width="520" loading="lazy" />
      <figcaption>AI 总管家：边做边汇报，写操作先审批，做完留痕可撤销</figcaption>
    </figure>
    <figure>
      <img src="/shots/nmail-demo-digest.png" alt="每日摘要页：统计卡片、近 7 天图表、分类分布、待回复清单" width="520" loading="lazy" />
      <figcaption>每日摘要：图表 + AI 摘要，一天的邮件一眼看完</figcaption>
    </figure>
  </section>

  <section class="band">
    <div>
      <h2>三步开始</h2>
      <ol>
        <li>安装并启动：<code>uvx --from nmail-app nmail</code>（没装 uv？<a href="/download/">下载页</a> 有官方安装命令；也可选免安装单文件）</li>
        <li>浏览器自动打开 <code>http://127.0.0.1:8720</code>，添加你的邮箱账号</li>
        <li>在设置里填入任意 OpenAI 兼容模型的 Key，AI 总管家即刻上岗</li>
      </ol>
    </div>
    <a class="btn btn-primary" href="/download/">前往下载</a>
  </section>
</Base>

<style>
  .hero { text-align: center; padding: 76px 0 40px; }
  .hero h1 {
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.25;
    margin: 18px 0 0;
    letter-spacing: -0.5px;
  }
  .grad {
    background: linear-gradient(90deg, #4f46e5, #0ea5e9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { max-width: 620px; margin: 18px auto 0; color: var(--ink-soft); font-size: 17px; }
  .cta { margin-top: 30px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  /* 主截图：圆角 + 边框 + 柔和投影，营造「窗中窗」的产品质感 */
  .shot-hero { text-align: center; margin: 0 0 10px; }
  .shot-hero img {
    width: 100%; height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgba(15, 23, 42, .13);
  }
  .caption { color: var(--ink-soft); font-size: 13.5px; margin: 14px 0 0; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin: 46px 0;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 18px;
    background: #fff;
  }
  .card .icon { font-size: 26px; }
  .card h2 { margin: 10px 0 6px; font-size: 17px; }
  .card p { margin: 0; color: var(--ink-soft); font-size: 14.5px; }
  /* 正文文字里的链接不能只靠颜色区分（无障碍 link-in-text-block），补下划线（.btn 按钮除外） */
  .pill a, .band li a { text-decoration: underline; }

  /* 双截图：左右各一，窄屏自动堆叠 */
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin: 0 0 46px; }
  .duo figure { margin: 0; }
  .duo img {
    width: 100%; height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgba(15, 23, 42, .10);
  }
  .duo figcaption { color: var(--ink-soft); font-size: 13.5px; text-align: center; margin-top: 10px; }
  @media (max-width: 720px) { .duo { grid-template-columns: 1fr; } }

  .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 30px;
    margin-bottom: 30px;
  }
  .band h2 { margin: 0 0 10px; font-size: 20px; }
  .band ol { margin: 0; padding-left: 20px; color: var(--ink-soft); }
  .band li { margin: 4px 0; }
</style>
